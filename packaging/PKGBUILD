# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=oostat-bin
_pkgname=oostat
pkgver=0.1.0
pkgrel=1
pkgdesc="Prints comprehensive file metadata, inode attributes, timestamps, and permissions."
arch=('x86_64')
url="https://github.com/openOODA-tools/oostat"
license=('Apache-2.0')
depends=('glibc')
provides=('oostat')
conflicts=('oostat')
source_x86_64=("${url}/releases/download/v${pkgver}/oostat-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/oostat-linux-x86_64" "${pkgdir}/usr/bin/oostat"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/oostat-uninstall"
}
